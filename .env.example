# Variables de entorno de THF (Vercel → Settings → Environment Variables, o `wrangler secret put` en Cloudflare).
# Este archivo es solo una guía: NUNCA pongas aquí valores reales ni lo subas con claves.

# --- Obligatorias en Vercel + Supabase
DATABASE_URL=postgresql://postgres.PROYECTO:CONTRASEÑA@aws-0-us-east-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Recomendada: certificado de Supabase (Project Settings → Database → SSL) para verificar el servidor
DATABASE_CA=
# Opcional: nombre del bucket privado (por defecto "thf")
SUPABASE_BUCKET=thf

# --- Obligatorias en las dos plataformas
# 32+ caracteres al azar. No la cambies nunca: si cambia, nadie puede entrar al panel.
THF_PEPPER=
# 16+ caracteres; se usa una sola vez en /setup
SETUP_TOKEN=
# Tu dominio, sin barra final
SITE_URL=https://tudominio.com

# --- Opcionales (se activan desde el panel cuando la marca quiera)
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
RESEND_API_KEY=
TELEGRAM_BOT_TOKEN=
NOTIFY_WEBHOOK_SECRET=
VERIFY_API_URL=
VERIFY_API_KEY=
# Compras reportadas desde el servidor (Panel → Sitio → Integraciones). Los IDs del píxel y de GA4 se ponen en el panel.
GA4_API_SECRET=
META_CAPI_TOKEN=

# --- Ajustes finos (tienen valores por defecto)
# PW_ITER=20000
# ADMIN_IDLE_MIN=60
# ADMIN_ABS_HOURS=12
# DB_POOL_MAX=3
